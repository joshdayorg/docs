{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Learn OpenClaw",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Tutorial",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "tutorial/introduction",
              "tutorial/installation",
              "tutorial/remote-access",
              "tutorial/imessage"
            ]
          },
          {
            "group": "Going Deeper",
            "pages": [
              "tutorial/soul",
              "tutorial/heartbeats",
              "tutorial/sub-agent",
              "tutorial/multi-agent",
              "tutorial/cron"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "OpenClaw Docs",
          "href": "https://docs.openclaw.ai",
          "icon": "book-open-cover"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/openclaw/openclaw",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "OpenClaw",
        "href": "https://openclaw.ai"
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/openclaw",
      "github": "https://github.com/openclaw/openclaw"
    }
  }
}
