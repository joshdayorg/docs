{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Claw School",
  "colors": {
    "primary": "#4AA8D8",
    "light": "#4AA8D8",
    "dark": "#4AA8D8",
    "background": {
      "dark": "#0A0E14",
      "light": "#FFFFFF"
    }
  },
  "favicon": "/favicon.svg",
  "css": "/custom.css",
  "navigation": {
    "tabs": [
      {
        "tab": "Tutorial",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "tutorial/introduction",
              "tutorial/installation",
              "tutorial/remote-access",
              "tutorial/imessage"
            ]
          },
          {
            "group": "Going Deeper",
            "pages": [
              "tutorial/soul",
              "tutorial/heartbeats",
              "tutorial/sub-agent",
              "tutorial/multi-agent",
              "tutorial/cron",
              "tutorial/custom-ui",
              "tutorial/advanced-patterns"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "OpenClaw Docs",
          "href": "https://docs.openclaw.ai",
          "icon": "book-open-cover"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/openclaw/openclaw",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Claw",
        "href": "https://claw.sh"
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/tryclawnow",
      "github": "https://github.com/openclaw/openclaw"
    }
  }
}
